; Recording indicator widget for transcribe-rs-v2
; Displays at bottom center of screen with audio level visualization

; Poll audio level from file (updated by recording-daemon)
; Returns 0-100 integer, defaults to 0 if file missing
(defpoll audio_level :interval "50ms"
  `cat /tmp/ptt_audio_level 2>/dev/null | grep -E '^[0-9]+$' || echo 0`)

; Recording indicator widget - level bar inside container
(defwidget recording-indicator []
  (box :class "level-container"
       :orientation "h"
       :halign "start"
    (box :class "level-bar"
         :style "min-width: ${audio_level == "" ? 0 : audio_level * 2}px;"
         :halign "start")))

; Window definition - positioned at bottom center
(defwindow recording
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "50px"
                      :width "200px"
                      :height "50px"
                      :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (recording-indicator))
