post_install() {
    echo ""
    echo "==> omarchy-stt installation complete!"
    echo ""
    echo "==> Next steps:"
    echo "    1. Initialize configuration:"
    echo "       $ transcribe config init"
    echo ""
    echo "    2. Edit ~/.config/transcribe-rs/config.toml to set:"
    echo "       - model_path = \"/usr/share/omarchy-stt/models/parakeet-tdt-0.6b-v3-int8\""
    echo "       - Your microphone device name in RECORDING_MICROPHONE"
    echo ""
    echo "    3. Enable and start daemons:"
    echo "       $ systemctl --user enable recording-daemon transcribe-daemon hotkey-daemon"
    echo "       $ systemctl --user start recording-daemon transcribe-daemon hotkey-daemon"
    echo ""
    echo "    4. Configure your dictation hotkey using your desktop environment,"
    echo "       or use the hotkey-daemon (recommended for Wayland)"
    echo ""
    echo "==> Optional: Enable LLM post-processing"
    echo "    - Set GROQ_API_KEY environment variable"
    echo "    - Enable 'llm_processing' in config.toml"
    echo ""
    echo "==> For help: transcribe --help"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> omarchy-stt upgraded to version $2"
    echo ""
    echo "==> Restart daemons to apply changes:"
    echo "    $ systemctl --user restart recording-daemon transcribe-daemon hotkey-daemon"
    echo ""
}

post_remove() {
    echo ""
    echo "==> omarchy-stt removed"
    echo ""
    echo "==> User configuration preserved in ~/.config/transcribe-rs/"
    echo "    Remove manually if desired: rm -rf ~/.config/transcribe-rs/"
    echo ""
}
