[Unit]
Description=Omarchy STT Recording Daemon
Documentation=https://github.com/yourusername/transcribe-rs-v2

[Service]
Type=simple
ExecStart=/usr/bin/recording-daemon
Restart=on-failure
RestartSec=5
Environment="RECORDING_MICROPHONE=alsa_input.usb-Blue_Microphones_Yeti_Stereo_Microphone_REV8-00.analog-stereo"

# Resource limits
MemoryMax=100M
CPUQuota=10%

[Install]
WantedBy=default.target
